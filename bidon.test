using AT99.Framework.Infra.Processus;
using AT99.Framework.Infra.Processus.Modeles;
using AT99.Framework.Infra.Processus.Modeles.Bpm;
using AutoFixture;
using AutoFixture.AutoNSubstitute;
using Autofac.Features.Indexed;
using FluentAssertions;
using NSubstitute;
using Xunit;

namespace AT99.Framework.Infra.Processus.Tests;

public class ServiceProcessusTests
{
    // ─────────────────────────────────────────────────────────────────────────
    // À ADAPTER : remplace par de vraies valeurs de TypeProcessus du projet.
    //   TypeTete      : EstProcessusDeTete = true
    //   TypeSous      : sous-processus (EstProcessusDeTete = false)
    //   TypeAutreTete : un 2e processus de tête (pour les cas multi-corrélations)
    // ─────────────────────────────────────────────────────────────────────────
    private static readonly TypeProcessus TypeTete = TypeProcessus.DECLARATION;
    private static readonly TypeProcessus TypeSous = TypeProcessus.SOUS_PROCESSUS;
    private static readonly TypeProcessus TypeAutreTete = TypeProcessus.PERIODE;

    // À ADAPTER si ProcessusBpm / TacheBpm se construisent autrement.
    private static ProcessusBpm Instance(long id, TypeProcessus type, long? parent = null) => new()
    {
        IdInstanceProcessus = id,
        IdInstanceProcessusParent = parent,
        IdProcessus = type.Nom, // valeur lue par Enumeration.DepuisNom<TypeProcessus>
    };

    private static TacheBpm Tache(long id, string code) => new() { Id = id, Code = code };

    // ─────────────────────────────────────────────────────────────────────────

    public sealed record Contenu(string Valeur);

    private readonly IFixture fixture = new Fixture().Customize(new AutoNSubstituteCustomization());

    private readonly IAgentServiceBpm agent;
    private readonly IAgentServiceTacheBpm agentTache;
    private readonly ServiceProcessusTestable service;

    // Données anonymes générées par AutoFixture.
    private readonly Correlation correlation;
    private readonly Contenu contenu;
    private readonly string signal;
    private readonly string codeTache;
    private readonly long idTete;
    private readonly long idSous;

    public ServiceProcessusTests()
    {
        agent = fixture.Freeze<IAgentServiceBpm>();
        agentTache = fixture.Freeze<IAgentServiceTacheBpm>();

        // Le même agent répond pour tous les modes de traitement.
        fixture.Freeze<IIndex<ModeTraitement, IAgentServiceBpm>>()[Arg.Any<ModeTraitement>()].Returns(agent);
        fixture.Freeze<IIndex<ModeTraitement, IAgentServiceTacheBpm>>()[Arg.Any<ModeTraitement>()].Returns(agentTache);

        service = fixture.Create<ServiceProcessusTestable>();

        correlation = new Correlation(fixture.Create<string>(), TypeTete);
        contenu = fixture.Create<Contenu>();
        signal = fixture.Create<string>();
        codeTache = fixture.Create<string>();
        idTete = fixture.Create<long>();
        idSous = fixture.Create<long>();
    }

    /// <summary>Supprime l'attente entre les tentatives et simule la recherche de tâche.</summary>
    public sealed class ServiceProcessusTestable(
        IIndex<ModeTraitement, IAgentServiceBpm> agents,
        IIndex<ModeTraitement, IAgentServiceTacheBpm> agentsTache)
        : ServiceProcessus(agents, agentsTache)
    {
        public Func<long, TacheBpm?> TacheDe { get; set; } = _ => null;
        public List<long> InstancesInterrogees { get; } = [];

        protected override IReadOnlyList<TimeSpan> DelaisAttenteTache { get; } =
            [TimeSpan.Zero, TimeSpan.Zero, TimeSpan.Zero];

        protected override Task<TacheBpm?> ObtenirTacheAPartirProcessusAsync(ModeTraitement mode, long numeroProcessus)
        {
            InstancesInterrogees.Add(numeroProcessus);
            return Task.FromResult(TacheDe(numeroProcessus));
        }
    }

    // ── Utilitaires ──────────────────────────────────────────────────────────

    private static Task<IEnumerable<ProcessusBpm>> Liste(params ProcessusBpm[] instances) =>
        Task.FromResult<IEnumerable<ProcessusBpm>>(instances);

    private void Instances(Correlation c, params ProcessusBpm[] instances) =>
        agent.ObtenirInstancesProcessusAsync(c.IdCorrelation).Returns(Liste(instances));

    private void Signaux(long idInstance, params string[] signaux) =>
        agent.ObtenirSignauxEnAttenteAsync(idInstance).Returns(Task.FromResult<IEnumerable<string>>(signaux));

    private Correlation AutreCorrelation() => new(fixture.Create<string>(), TypeAutreTete);

    /// <summary>EmettreSignalAsync est générique : on vérifie par nom de méthode, quel que soit T.</summary>
    private void VerifierAucuneEmission() =>
        agent.ReceivedCalls()
            .Should().NotContain(c => c.GetMethodInfo().Name == nameof(IAgentServiceBpm.EmettreSignalAsync));

    private Func<Task<long>> Avancer(params Correlation[] correlations) =>
        () => service.AvancerATacheSuivanteAsync(correlations, [signal], contenu, codeTache);

    // ── EstProcessusEnCoursAsync ─────────────────────────────────────────────

    [Fact]
    public async Task EstProcessusEnCoursRetourneVraiSiUneInstanceExisteAsync()
    {
        Instances(correlation, Instance(idTete, TypeTete));

        (await service.EstProcessusEnCoursAsync(correlation)).Should().BeTrue();
    }

    [Fact]
    public async Task EstProcessusEnCoursRetourneFauxSiAucuneInstanceAsync()
    {
        Instances(correlation);

        (await service.EstProcessusEnCoursAsync(correlation)).Should().BeFalse();
    }

    // ── DemarrerProcessusAsync / TerminerTacheAsync ──────────────────────────

    [Fact]
    public async Task DemarrerProcessusCreeLeProcessusAvecLaCorrelationAsync()
    {
        var idCree = fixture.Create<long>();
        agent.CreerSansDateProductionAsync(TypeTete.Code, Arg.Any<Dictionary<string, object>>(), correlation.IdCorrelation)
            .Returns(Task.FromResult(idCree));

        (await service.DemarrerProcessusAsync(correlation, new ProcessusAT())).Should().Be(idCree);
    }

    [Fact]
    public async Task TerminerTacheDelegueAAgentDeTacheAsync()
    {
        var numeroTache = fixture.Create<long>();

        await service.TerminerTacheAsync(numeroTache, contenu, TypeTete.ModeTraitement);

        await agentTache.Received(1).TerminerAsync(numeroTache, contenu);
    }

    // ── AvancerATacheSuivanteAsync : recherche du signal ─────────────────────

    [Fact]
    public async Task AvancerEchoueSiAucunProcessusAsync()
    {
        Instances(correlation);

        await Avancer(correlation).Should().ThrowAsync<ProcessusBpmException>()
            .Where(e => e.Raison == RaisonEchecProcessus.AucunProcessus);
        VerifierAucuneEmission();
    }

    [Fact]
    public async Task AvancerIgnoreLesCorrelationsQuiNeSontPasDeTeteAsync()
    {
        var correlationSous = new Correlation(fixture.Create<string>(), TypeSous);

        await Avancer(correlationSous).Should().ThrowAsync<ProcessusBpmException>()
            .Where(e => e.Raison == RaisonEchecProcessus.AucunProcessus);
        await agent.DidNotReceiveWithAnyArgs().ObtenirInstancesProcessusAsync(default!);
    }

    [Fact]
    public async Task AvancerEchoueSiAucunSignalAttenduAsync()
    {
        Instances(correlation, Instance(idTete, TypeTete));
        Signaux(idTete, fixture.Create<string>());

        await Avancer(correlation).Should().ThrowAsync<ProcessusBpmException>()
            .Where(e => e.Raison == RaisonEchecProcessus.AucunSignalEnAttente);
        VerifierAucuneEmission();
    }

    [Fact]
    public async Task AvancerTraiteSignauxNullCommeListeVideAsync()
    {
        Instances(correlation, Instance(idTete, TypeTete));
        agent.ObtenirSignauxEnAttenteAsync(idTete).Returns(Task.FromResult<IEnumerable<string>>(null!));

        await Avancer(correlation).Should().ThrowAsync<ProcessusBpmException>()
            .Where(e => e.Raison == RaisonEchecProcessus.AucunSignalEnAttente);
    }

    [Fact]
    public async Task AvancerSansEmissionSiPlusieursInstancesAttendentLeSignalAsync()
    {
        var correlation2 = AutreCorrelation();
        var idAutre = fixture.Create<long>();
        Instances(correlation, Instance(idTete, TypeTete));
        Instances(correlation2, Instance(idAutre, TypeAutreTete));
        Signaux(idTete, signal);
        Signaux(idAutre, signal);

        await Avancer(correlation, correlation2).Should().ThrowAsync<ProcessusBpmException>()
            .Where(e => e.Raison == RaisonEchecProcessus.SignalAmbigu);
        VerifierAucuneEmission();
    }

    [Fact]
    public async Task AvancerInterrogeSeulementInstanceLaPlusBasseDeChaqueChaineAsync()
    {
        Instances(correlation, Instance(idTete, TypeTete), Instance(idSous, TypeSous, parent: idTete));
        Signaux(idSous, signal);
        service.TacheDe = id => id == idTete ? Tache(fixture.Create<long>(), codeTache) : null;

        await Avancer(correlation)();

        await agent.DidNotReceive().ObtenirSignauxEnAttenteAsync(idTete);
        await agent.Received(1).ObtenirSignauxEnAttenteAsync(idSous);
    }

    // ── AvancerATacheSuivanteAsync : émission et tâche suivante ──────────────

    [Fact]
    public async Task AvancerEmetLeSignalEtRetourneLaTacheSuivanteAsync()
    {
        var idTache = fixture.Create<long>();
        Instances(correlation, Instance(idTete, TypeTete), Instance(idSous, TypeSous, parent: idTete));
        Signaux(idSous, fixture.Create<string>(), signal);
        service.TacheDe = id => id == idTete ? Tache(idTache, codeTache) : null;

        var resultat = await service.AvancerATacheSuivanteAsync(
            [correlation], [fixture.Create<string>(), signal], contenu, codeTache);

        resultat.Should().Be(idTache);
        await agent.Received(1).EmettreSignalAsync(idSous, signal, contenu);
    }

    [Fact]
    public async Task AvancerAttendQueLeMoteurCreeLaTacheSuivanteAsync()
    {
        var idTache = fixture.Create<long>();
        Instances(correlation, Instance(idTete, TypeTete));
        Signaux(idTete, signal);
        var appels = 0;
        // 1re lecture : ancienne tâche encore présente ; 2e : tâche suivante créée.
        service.TacheDe = _ => ++appels == 1
            ? Tache(fixture.Create<long>(), fixture.Create<string>())
            : Tache(idTache, codeTache);

        var resultat = await Avancer(correlation)();

        resultat.Should().Be(idTache);
        appels.Should().Be(2);
    }

    [Fact]
    public async Task AvancerTrouveLaTacheDansUnSousProcessusDemarreParLeSignalAsync()
    {
        var idTache = fixture.Create<long>();
        agent.ObtenirInstancesProcessusAsync(correlation.IdCorrelation).Returns(
            Liste(Instance(idTete, TypeTete)),                                         // recherche du signal
            Liste(Instance(idTete, TypeTete), Instance(idSous, TypeSous, parent: idTete))); // après le signal
        Signaux(idTete, signal);
        service.TacheDe = id => id == idSous ? Tache(idTache, codeTache) : null;

        (await Avancer(correlation)()).Should().Be(idTache);
    }

    [Fact]
    public async Task AvancerChercheLaTacheSeulementDansLaCorrelationSignaleeAsync()
    {
        var correlation2 = AutreCorrelation();
        var idAutre = fixture.Create<long>();
        var idTache = fixture.Create<long>();
        Instances(correlation, Instance(idTete, TypeTete));
        Instances(correlation2, Instance(idAutre, TypeAutreTete));
        Signaux(idTete, signal);
        service.TacheDe = id => id == idTete ? Tache(idTache, codeTache) : Tache(fixture.Create<long>(), codeTache);

        var resultat = await Avancer(correlation, correlation2)();

        resultat.Should().Be(idTache);
        service.InstancesInterrogees.Should().NotContain(idAutre);
        await agent.Received(1).ObtenirInstancesProcessusAsync(correlation2.IdCorrelation); // recherche du signal seulement
    }

    [Fact]
    public async Task AvancerEchoueSiLaTacheSuivanteEstIntrouvableAsync()
    {
        Instances(correlation, Instance(idTete, TypeTete));
        Signaux(idTete, signal);
        service.TacheDe = _ => Tache(fixture.Create<long>(), fixture.Create<string>());

        await Avancer(correlation).Should().ThrowAsync<ProcessusBpmException>()
            .Where(e => e.Raison == RaisonEchecProcessus.TacheSuivanteIntrouvable);

        // Le signal est déjà émis : le front doit relire la tâche, pas relancer l'action.
        await agent.Received(1).EmettreSignalAsync(idTete, signal, Arg.Any<Contenu>());
    }

    [Fact]
    public async Task AvancerEchoueSiPlusieursTachesPortentLeCodeAsync()
    {
        Instances(correlation, Instance(idTete, TypeTete), Instance(idSous, TypeSous, parent: idTete));
        Signaux(idSous, signal);
        service.TacheDe = id => Tache(id, codeTache);

        await Avancer(correlation).Should().ThrowAsync<ProcessusBpmException>()
            .Where(e => e.Raison == RaisonEchecProcessus.TacheSuivanteAmbigue);
    }

    // ── TerminerTacheSiEnAttenteAsync (obsolète) ─────────────────────────────

#pragma warning disable CS0618
    [Fact]
    public async Task TerminerSiEnAttenteRetourneLeParentDeInstanceSignaleeAsync()
    {
        Instances(correlation, Instance(idTete, TypeTete), Instance(idSous, TypeSous, parent: idTete));
        Signaux(idSous, signal);

        (await service.TerminerTacheSiEnAttenteAsync([correlation], [signal], contenu)).Should().Be(idTete);
    }

    [Fact]
    public async Task TerminerSiEnAttenteRetourneInstanceElleMemeSiRacineAsync()
    {
        Instances(correlation, Instance(idTete, TypeTete));
        Signaux(idTete, signal);

        (await service.TerminerTacheSiEnAttenteAsync([correlation], [signal], contenu)).Should().Be(idTete);
    }

    [Fact]
    public async Task TerminerSiEnAttenteRetourneNullSiAucunProcessusAsync()
    {
        Instances(correlation);

        (await service.TerminerTacheSiEnAttenteAsync([correlation], [signal], contenu)).Should().BeNull();
    }

    [Fact]
    public async Task TerminerSiEnAttenteRetourneNullSansEmettreSiAucunSignalAttenduAsync()
    {
        Instances(correlation, Instance(idTete, TypeTete));
        Signaux(idTete, fixture.Create<string>());

        (await service.TerminerTacheSiEnAttenteAsync([correlation], [signal], contenu)).Should().BeNull();
        VerifierAucuneEmission();
    }
#pragma warning restore CS0618

    // ── TerminerTacheEnAttenteAsync ──────────────────────────────────────────

    [Fact]
    public async Task TerminerEnAttenteEmetLeSignalSansContenuAsync()
    {
        Instances(correlation, Instance(idTete, TypeTete));
        Signaux(idTete, signal);

        await service.TerminerTacheEnAttenteAsync([correlation], signal);

        await agent.Received(1).EmettreSignalAsync<object?>(idTete, signal, null);
    }

    [Fact]
    public async Task TerminerEnAttenteEchoueSiSignalNonAttenduAsync()
    {
        Instances(correlation, Instance(idTete, TypeTete));
        Signaux(idTete, fixture.Create<string>());

        var action = () => service.TerminerTacheEnAttenteAsync([correlation], signal);

        await action.Should().ThrowAsync<ProcessusBpmException>()
            .Where(e => e.Raison == RaisonEchecProcessus.AucunSignalEnAttente);
    }
}
